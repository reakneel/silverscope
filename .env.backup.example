# Keep the real URI in your shell or secret manager; never commit a populated file.
# Use the Supabase direct URI (IPv6-capable network) or Session pooler URI.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[URL-ENCODED-PASSWORD]@[host]:5432/postgres?sslmode=require

# Restore is intentionally restricted to local targets by the restore scripts.
RESTORE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
ALLOW_DESTRUCTIVE_RESTORE=YES

# Supabase Storage local sync (service-role key stays on your workstation only)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
