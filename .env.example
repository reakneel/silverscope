# Supabase (configure only after provisioning a project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FRED macro data (requires a registered API key)
FRED_API_KEY=

# Protect scheduled/manual ingestion and scoring requests
CRON_SECRET=

# Empirically estimated feature calibration JSON; do not use placeholder values in production
SILVER_FEATURE_CALIBRATION_JSON=

# Licensed market data CSV import (only set LICENSE_STATUS=licensed after obtaining appropriate usage rights)
MARKET_DATA_LICENSE_STATUS=unverified
MARKET_DATA_PROVIDER_NAME=
MARKET_DATA_SOURCE_URL=

# Billing (set only after Stripe products/prices and webhook endpoint are configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
# Display labels must match the amounts configured for the Stripe Price IDs.
STRIPE_PRICE_PRO_DISPLAY=$29
STRIPE_PRICE_ULTRA_DISPLAY=$99
NEXT_PUBLIC_APP_URL=http://localhost:3000
